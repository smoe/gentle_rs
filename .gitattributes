# Keep committed tutorial outputs visible in GitHub browsing, but exclude them
# from source tarballs produced by `git archive`.
docs/tutorial/generated export-ignore
docs/tutorial/generated/** export-ignore

# PDFs are generated/binary figure artifacts; do not run text whitespace checks
# against their xref tables.
*.pdf binary

# Cross-platform candidate receipts bind the lockfile's exact bytes.
Cargo.lock text eol=lf

# The generated capability matrix is compared byte-for-byte with LF output.
docs/gui_cli_mcp_parity.md text eol=lf

# Generated tutorial indexes are checked byte-for-byte against LF serialization.
docs/tutorial/catalog.json text eol=lf
docs/tutorial/manifest.json text eol=lf

# Public GUI evidence records exact hashes for these LF-authored text artifacts.
docs/screenshots/gene_assay_study_gui/*.snapshot.json text eol=lf
docs/screenshots/gene_assay_study_gui/*.context.svg text eol=lf
docs/screenshots/tss_regulatory_view_gui/*.snapshot.json text eol=lf

test_files/fixtures/transcript_assay_panel/patz1_reference/* text eol=lf
# Preserve the exact hash-bound NCBI response, including its final blank line.
test_files/fixtures/transcript_assay_panel/patz1_reference/refseq_genome.fasta whitespace=-blank-at-eof

# Keep the hashed TP73 BLAST fixture byte-identical on Windows checkouts.
test_files/fixtures/blast_tp73_isoforms/*.fasta text eol=lf

# PATZ1 tutorial reports bind these exact input bytes, including line endings.
test_files/fixtures/isoform_evidence/patz1/patz1_probe_evidence.json text eol=lf
test_files/fixtures/transcript_assay_panel/patz1/patz1_assay_isoform_evidence.json text eol=lf

# BED sidecar manifests bind the retained exports byte-for-byte.
docs/tutorial/generated/**/*.bed text eol=lf

# The retained SERPINE1 figure binds the occupancy source's exact bytes.
test_files/fixtures/genomic_regions/serpine1_offline/synthetic_serpine1_cutrun.bed text eol=lf

# TSS manifests and context receipts bind these exact fixture bytes.
test_files/fixtures/tss_profiles/** text eol=lf

# The native TSS-view tutorial retains hash-bound JSON and annotated GenBank inputs.
docs/tutorial/reproducibility/tss_regulatory_view_gui/** text eol=lf
# Keep the hash-bound export's padded GenBank ORIGIN line byte-identical.
docs/tutorial/reproducibility/tss_regulatory_view_gui/synthetic-minus.annotated-tss.gb whitespace=-blank-at-eol

# This retained adapter output is compared byte-for-byte with LF serialization.
test_files/fixtures/probe_region_outputs/clariom_e_mtab_14704_tp73_validation/* text eol=lf

# Its provenance binds the adapter input's exact bytes on every platform.
test_files/fixtures/probe_region_adapter_inputs/clariom_e_mtab_14704_tp73_glen_style.csv text eol=lf
