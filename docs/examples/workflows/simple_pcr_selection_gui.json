{
  "schema": "gentle.workflow_example.v1",
  "id": "simple_pcr_selection_gui",
  "title": "Simple PCR starter project on compact TP73 context (offline)",
  "summary": "Extract the same 800-base TP73 window used by the scripted PCR oracle, retain the source locus for provenance, and pin the internal primer backend. The GUI designs on the compact window, not the full locus.",
  "test_mode": "always",
  "required_files": [
    "test_files/tp73.ncbi.gb"
  ],
  "tags": [
    "tutorial",
    "pcr",
    "primer",
    "tp73",
    "offline"
  ],
  "workflow": {
    "run_id": "example_simple_pcr_selection_gui",
    "ops": [
      {
        "LoadFile": {
          "path": "test_files/tp73.ncbi.gb",
          "as_id": "simple_pcr_source_locus"
        }
      },
      {
        "ExtractRegion": {
          "input": "simple_pcr_source_locus",
          "from": 61520,
          "to": 62320,
          "output_id": "tp73_locus"
        }
      },
      {
        "SetParameter": {
          "name": "primer_design_backend",
          "value": "internal"
        }
      }
    ]
  }
}
