{
  "schema": "gentle.workflow_example.v1",
  "id": "tss_collection_gui_oracle",
  "title": "Synthetic TSS collection oracle",
  "summary": "Independent approved derivation for comparison only. Never use as the GUI starter.",
  "test_mode": "always",
  "required_files": [
    "docs/examples/assets/tss_tutorial/genomes.json",
    "docs/examples/assets/tss_tutorial/locus.fa",
    "docs/examples/assets/tss_tutorial/locus.gtf"
  ],
  "tags": [
    "offline",
    "gui-acceptance",
    "tss",
    "synthetic",
    "oracle"
  ],
  "workflow": {
    "run_id": "tss_collection_gui_oracle",
    "ops": [
      {
        "PrepareGenome": {
          "genome_id": "TutorialTssToy",
          "catalog_path": "docs/examples/assets/tss_tutorial/genomes.json",
          "cache_dir": "artifacts/tss_cache"
        }
      },
      {
        "ExtractGenomeRegion": {
          "genome_id": "TutorialTssToy",
          "chromosome": "toy_chr",
          "start_1based": 1,
          "end_1based": 2000,
          "output_id": "tss_locus",
          "include_genomic_annotation": true,
          "catalog_path": "docs/examples/assets/tss_tutorial/genomes.json",
          "cache_dir": "artifacts/tss_cache"
        }
      },
      {
        "MaterializeTssWindows": {
          "request": {
            "inventory": {
              "seq_id": "tss_locus",
              "gene_query": "TOY",
              "collection_id": "tss_windows",
              "upstream_bp": 500,
              "downstream_bp": 200
            },
            "expected_approval_sha256": "sha256:41a5188abaff43e57a18519a05cced49b9f2cf141432208ab090bbe91e8dacbd",
            "selected_tss_ids": [
              "tss_3802843ea468a70f5488b98934cb9d2a9c32748338caee845cb22a47ed0376de",
              "tss_4a7c324d45762e75bcb1a72513638c9c0a22676a1cf80008796ad3106cf7bfb6",
              "tss_9fec0328a5c218b980422400ce4203a7bb07e3537e5e4de3d67e98113addf134"
            ]
          }
        }
      }
    ]
  }
}
